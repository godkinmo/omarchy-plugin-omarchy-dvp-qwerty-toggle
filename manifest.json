{
  "schemaVersion": 1,
  "id": "godkin.omarchy-dvp-qwerty-toggle",
  "name": "Kanata Service Toggle",
  "version": "1.0.0",
  "author": "godkin",
  "license": "MIT",
  "description": "Toggle the kanata.service and kanata-layer-watcher.service user units from the Omarchy bar, with live status.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Kanata",
    "description": "Toggle the kanata keyboard remapper and its DVP/QWERTY layer watcher.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "kanataUnit",
        "type": "string",
        "label": "Kanata unit",
        "defaultValue": "kanata.service"
      },
      {
        "key": "watcherUnit",
        "type": "string",
        "label": "Layer watcher unit",
        "defaultValue": "kanata-layer-watcher.service"
      }
    ]
  }
}
