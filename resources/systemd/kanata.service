[Unit]
Description=kanata keyboard remapper (Programmer Dvorak + QWERTY overlays)
Documentation=https://github.com/jtroo/kanata
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# kanata_cmd_allowed enables the `cmd`/IPC features needed by the layer watcher.
ExecStart=/usr/bin/kanata_cmd_allowed -c @HOME@/.config/kanata/active.kbd --port 17000
Restart=always
RestartSec=2
[Install]
WantedBy=graphical-session.target
