[Unit]
Description=kanata keyboard remapper (Programmer Dvorak + QWERTY overlays)
Documentation=https://github.com/jtroo/kanata
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# kanata_cmd_allowed enables the `cmd`/IPC features needed by the layer watcher.
# --nodelay removes kanata's 2s startup delay: that window grabs the keyboard
# before kanata is ready, so a key pressed during it loses its release and
# auto-repeats.
ExecStart=/usr/bin/kanata_cmd_allowed --nodelay -c @HOME@/.config/kanata/active.kbd --port 127.0.0.1:17000
Restart=always
RestartSec=2
[Install]
WantedBy=graphical-session.target
